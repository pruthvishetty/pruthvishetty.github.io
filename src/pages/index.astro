---
import BaseLayout from '../layouts/BaseLayout.astro';

/* The places — a deck of postcards from a life so far. */
const cities = [
  { img: 'sf.jpeg', name: 'San Francisco', note: '2023 — present · home' },
  { img: 'byndoor.jpg', name: 'Udupi', note: 'where it all began' },
  { img: 'bangalore.jpg', name: 'Bengaluru', note: 'engineering years · IISc' },
  { img: 'btown.jpeg', name: 'Bloomington', note: '2015 – 2017 · grad school' },
  { img: 'indy.jpeg', name: 'Indianapolis', note: '2017 · the internship' },
  { img: 'newport-beach.jpeg', name: 'Newport Beach', note: '2018 – 2019 · SAP days' },
  { img: 'emeryville.jpg', name: 'Emeryville', note: '2019 – 2023 · Zaplabs' },
];

const journey = [
  {
    co: 'Samsara', role: 'Senior Staff AI Engineer', where: 'San Francisco', when: '2025 — present',
    url: 'https://www.samsara.com/',
    story: 'I lead the AI team building intelligent tools across Sales and Support, helping our GTM engine run smarter. Zach and I reunited after Twilio — every win still earns a virtual high five.',
    links: [{ text: 'Zach', href: 'https://www.linkedin.com/in/zach-merritt-54904066/' }],
  },
  {
    co: 'Twilio', role: 'Principal AI/ML Engineer', where: 'San Francisco', when: '2023 — 2025',
    url: 'https://www.twilio.com/',
    story: 'Led the internal AI/ML team delivering 0→1 GenAI products that streamlined operations across every business vertical. Lucky to build alongside exceptional teammates like Nick and Felix.',
    links: [
      { text: 'Nick', href: 'https://www.linkedin.com/in/nickmpaz/' },
      { text: 'Felix', href: 'https://www.linkedin.com/in/inetimi/' },
    ],
  },
  {
    co: 'Zaplabs → Compass', role: 'Machine Learning Engineer', where: 'Emeryville', when: '2019 — 2023',
    url: 'https://www.compass.com/',
    story: 'End-to-end development and deployment of ML models for a line of PropTech products (Zaplabs was acquired by Compass). Found an awesome mentor in Tony Kueh here.',
    links: [{ text: 'Tony Kueh', href: 'https://www.linkedin.com/in/tonykueh/' }],
  },
  {
    co: 'SAP Labs', role: 'Data Scientist', where: 'Palo Alto & Newport Beach', when: '2017 — 2019',
    url: 'https://www.sap.com/',
    story: 'Built and shipped scalable ML features on the SAP Cloud Machine Learning team, used by thousands of customers. Learned the craft from seasoned engineers like Peter Colligan.',
    links: [{ text: 'Peter Colligan', href: 'https://www.linkedin.com/in/petercolligan/' }],
  },
  {
    co: 'Anthem', role: 'Data Engineering Intern', where: 'Indianapolis', when: '2017',
    url: 'https://www.anthem.com/',
    story: 'Interned with the Obamacare Infrastructure & Analytics team. Jon Walthour taught me a great deal about data infrastructure, U.S. polity — and cars.',
    links: [{ text: 'Jon Walthour', href: 'https://www.linkedin.com/in/jwalthour/' }],
  },
  {
    co: 'Indiana University', role: 'M.S. Computer Science', where: 'Bloomington', when: '2015 — 2017',
    url: 'https://www.indiana.edu/',
    story: 'Studied, researched, and helped teach — specializing in ML and Data Science, mentored by the amazing Dr. Travis Brown. IU has one of the most beautiful campuses in the country; you’d almost always find me in one of these places.',
    links: [
      { text: 'Dr. Travis Brown', href: 'https://luddy.indiana.edu/contact/profile/?Travis_Brown' },
      { text: 'one of these places', href: 'https://medium.com/@pruthvishetty/bloomington-101-32f534e8c038#8f85' },
    ],
  },
  {
    co: 'Indian Institute of Science', role: 'Research Assistant', where: 'Bengaluru', when: '2014 — 2015',
    url: 'https://www.iisc.ac.in/',
    story: 'Parallel computing research for Intel at India’s #1 university, with its famously gorgeous campus. Learned a whole lot sharing a lab with smarts like Prakash Murali and Nitin Bhat.',
    links: [
      { text: 'Prakash Murali', href: 'https://prakashmurali.bitbucket.io/' },
      { text: 'Nitin Bhat', href: 'https://www.linkedin.com/in/nbhat4/' },
    ],
  },
  {
    co: 'Earlier still', role: 'Unisys R&D · GE · Bloom', where: 'Bengaluru & Bloomington', when: '2013 — 2016',
    url: null,
    story: 'Hybrid mobile apps with the R&D team at Unisys, CRM modules at General Electric, and a summer of .NET and cross-platform builds at Bloom in Bloomington.',
    links: [],
  },
];

const projects = [
  { name: 'X-GPT', org: 'Twilio', blurb: 'LLM-powered internal Q&A over product info, CRM data, sales playbooks and transcribed demos — an AI sidekick for the entire GTM team.' },
  { name: 'RFP Genie', org: 'Twilio', blurb: 'Automated RFP responses with first-party product knowledge. Cut response times from 3–5 weeks to under 15 minutes, with >90% acceptance.' },
  { name: 'Lead Farmer', org: 'Zaplabs', blurb: 'Buy/sell-side lead scoring used by Coldwell Banker, Century 21, Sotheby’s and more — monthly leads for 4,000+ brokerages.' },
  { name: 'Agent Network', org: 'Zaplabs', blurb: 'Graph-based referral recommendations across all Anywhere RE brands. Referred closings improved by >30%.' },
  { name: 'Market Periscope', org: 'Zaplabs', blurb: 'Time-series forecasts of real-estate market share across brands, franchisees, and competitors.' },
  { name: 'SmartAssign', org: 'SAP', blurb: 'Constraint-optimization engine in SAP Service Cloud that routes leads to the best-fit sales reps.' },
  { name: 'Time to Completion', org: 'SAP', blurb: 'Predictive ticket-resolution estimates built into SAP Service Cloud.' },
  { name: 'Quick Deploy', org: 'SAP', blurb: 'Automated model-deployment pipeline for SAP Cloud Platform — TensorFlow Serving, GDPR-compliant ingestion, and a Go→Python port of “Boom” for load testing.' },
];

const research = [
  { name: 'Machine Learning Group', org: 'Indiana University', blurb: 'Custom tree-based ensembles with Prof. Mehmet Dalkilic’s group, collating gene lesions implicated in human inherited disease.', href: 'https://luddy.indiana.edu/contact/profile/?profile_id=187' },
  { name: 'Atmospheric Modeling', org: 'Indiana University', blurb: 'Built and parallelized CAM 5.3 atmospheric modeling systems on IU’s supercomputers — Big Red II and Karst — with Prof. Chanh Kieu.', href: 'https://earth.indiana.edu/directory/faculty/kieu-chanh.html' },
  { name: 'Intel Parallel Computing Center', org: 'IISc', blurb: 'Optimized parallel CESM climate models on Intel’s MIC architecture at Prof. Sathish Vadhiyar’s lab, SERC.', href: 'https://cds.iisc.ac.in/people/sathish-s-vadhiyar/' },
];

const hackathons = [
  { name: 'DevGPT', event: 'Twilio Comms Hackathon · 2023', win: false, blurb: 'A coding assistant embedded with all of Twilio’s developer docs.' },
  { name: 'Agent CoPilot', event: 'Anywhere RE Hackathon · 2022', win: true, blurb: 'GPT-powered listings, SEO ads, and natural-language search for real-estate agents.' },
  { name: 'Office Assist', event: 'SAP Accessibility Hackathon · 2019', win: false, blurb: 'Gesture-to-speech with Alexa + TensorFlow, for colleagues who cannot speak.' },
  { name: 'Deep Reader', event: 'SAP Hackathon · 2018', win: true, blurb: 'TensorFlow text summarization based on Google’s TextSum.' },
  { name: 'Jarvis', event: 'IU Hackathon · 2017', win: false, blurb: 'A Markov-chain Twitter bot. Occasionally, accidentally philosophical.' },
  { name: 'iPay', event: 'Unisys Cloud 20/20 · 2014', win: true, blurb: 'Biometric payments — 2nd in India, later funded by the Dept. of Science & Technology, Govt. of India.' },
];

const community = [
  { name: 'Govt. of Karnataka', role: 'Pro bono consultant', blurb: 'Supporting the Office of the Additional Chief Secretary on Data Science and ML initiatives toward the Sustainable Development Goals.' },
  { name: 'Isha Foundation', role: 'Volunteer', blurb: 'Helping the tech team with GenAI efforts.' },
  { name: 'University of Notre Dame', role: 'Mentor & speaker', blurb: 'Speaking to graduating Data Science cohorts and mentoring folks along the way.' },
];
---

<BaseLayout title="Pruthvi Shetty — AI engineer, chai enthusiast, occasional poet">
  <!-- ===================== HERO ===================== -->
  <section class="hero wrap">
    <div class="hero-text">
      <p class="eyebrow reveal">Namaskara · ನಮಸ್ಕಾರ</p>
      <h1 class="reveal" style="--reveal-delay:.08s">
        I’m <span class="squiggle">Pruthvi<svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M2 7 Q 14 2, 26 6 T 50 6 T 74 6 T 98 5" /></svg></span><button id="pronounce" class="pron" title="How do you say that?" aria-label="Hear the pronunciation">🔊</button>
      </h1>
      <p class="hero-line reveal" style="--reveal-delay:.16s">
        I teach machines to be useful — and kettles to sing.
      </p>
      <p class="hero-sub reveal" style="--reveal-delay:.24s">
        Senior Staff AI Engineer at <a href="https://www.samsara.com/" target="_blank" rel="noopener">Samsara</a>, building
        agents that automate everything except my meetings. I write
        <a href="/writing/">poems over chai</a>, and make
        <a href="/tools/">free tools</a> that never phone home.
      </p>
      <div class="hero-cta reveal" style="--reveal-delay:.32s">
        <a class="btn btn-primary" href="#story">The story so far ↓</a>
        <a class="btn" href="/writing/">Writing</a>
        <a class="btn" href="/tools/">Tools</a>
      </div>
    </div>

    <!-- The postcard deck: every city I've called home. Click to shuffle. -->
    <div class="postcards reveal" style="--reveal-delay:.2s">
      <button id="postcard" class="postcard" title="Next postcard" aria-label="Show the next city postcard">
        <span class="tape" aria-hidden="true"></span>
        <img id="postcard-img" src={`/assets/images/${cities[0].img}`} alt={cities[0].name} width="420" height="300" />
        <span class="stub">
          <span id="postcard-name">{cities[0].name}</span>
          <span id="postcard-note" class="stub-note">{cities[0].note}</span>
        </span>
      </button>
      <p class="postcard-hint mono-label">↻ tap the postcard — {cities.length} cities, one life</p>
    </div>
  </section>

  <!-- ===================== INTRO ===================== -->
  <section class="wrap intro" id="story">
    <p class="prose dropcap reveal">
      My path runs from a small coastal town in <em>Udupi, Karnataka</em> to San Francisco — through
      research benches at the <a href="https://www.iisc.ac.in/" target="_blank" rel="noopener">Indian Institute of Science</a>,
      a Master’s in CS at <a href="https://www.indiana.edu/" target="_blank" rel="noopener">Indiana University</a>,
      and a decade of building machine learning systems that people actually use:
      at <a href="https://www.sap.com/" target="_blank" rel="noopener">SAP Labs</a>, Zaplabs (acquired by
      <a href="https://www.compass.com/" target="_blank" rel="noopener">Compass</a>),
      <a href="https://www.twilio.com/" target="_blank" rel="noopener">Twilio</a>, and now
      <a href="https://www.samsara.com/" target="_blank" rel="noopener">Samsara</a>.
      Along the way: hackathon trophies, supercomputers, a few thousand cups of chai.
    </p>
  </section>

  <div class="ornament" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M5 9h12v4.5a5 5 0 0 1-5 5H10a5 5 0 0 1-5-5V9Z" /><path d="M17 10.5h1.4a2.3 2.3 0 0 1 0 4.6H16.6" />
    </svg>
  </div>

  <!-- ===================== JOURNEY ===================== -->
  <section class="wrap" id="work">
    <p class="eyebrow reveal">The journey</p>
    <h2 class="section-title reveal">Great teams, good fortune.</h2>

    <ol class="timeline">
      {journey.map((j) => (
        <li class="tl-item reveal">
          <div class="tl-when">
            <span class="mono-label">{j.when}</span>
            <span class="tl-where mono-label">{j.where}</span>
          </div>
          <div class="tl-dot" aria-hidden="true"></div>
          <div class="tl-body">
            <h3>
              {j.url ? <a href={j.url} target="_blank" rel="noopener">{j.co}</a> : j.co}
            </h3>
            <p class="tl-role">{j.role}</p>
            <p class="tl-story" set:html={
              j.links.reduce(
                (s, l) => s.replace(l.text, `<a href="${l.href}" target="_blank" rel="noopener">${l.text}</a>`),
                j.story
              )
            } />
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ===================== PROJECTS ===================== -->
  <section class="wrap section-gap">
    <p class="eyebrow reveal">Selected work</p>
    <h2 class="section-title reveal">Projects I’m fond of.</h2>
    <div class="card-grid">
      {projects.map((p, i) => (
        <article class="card project-card reveal" style={`--reveal-delay:${(i % 3) * 0.07}s`}>
          <span class="org-tag">{p.org}</span>
          <h3>{p.name}</h3>
          <p>{p.blurb}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ===================== RESEARCH ===================== -->
  <section class="wrap section-gap">
    <p class="eyebrow reveal">Re·search</p>
    <h2 class="section-title reveal">Time among the supercomputers.</h2>
    <div class="card-grid three">
      {research.map((r, i) => (
        <article class="card project-card reveal" style={`--reveal-delay:${i * 0.07}s`}>
          <span class="org-tag">{r.org}</span>
          <h3>{r.name}</h3>
          <p>{r.blurb} <a href={r.href} target="_blank" rel="noopener">↗</a></p>
        </article>
      ))}
    </div>
  </section>

  <!-- ===================== HACKATHONS ===================== -->
  <section class="wrap section-gap">
    <p class="eyebrow reveal">After hours</p>
    <h2 class="section-title reveal">Hackathons are fun.</h2>
    <ul class="hack-list">
      {hackathons.map((h) => (
        <li class="hack-item reveal">
          <span class="hack-name">
            {h.name} {h.win && <span class="trophy" title="Winner">🏆</span>}
          </span>
          <span class="hack-dots" aria-hidden="true"></span>
          <span class="hack-meta mono-label">{h.event}</span>
          <p class="hack-blurb">{h.blurb}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ===================== COMMUNITY ===================== -->
  <section class="wrap section-gap">
    <p class="eyebrow reveal">Giving back</p>
    <h2 class="section-title reveal">Community.</h2>
    <div class="card-grid three">
      {community.map((c, i) => (
        <article class="card project-card reveal" style={`--reveal-delay:${i * 0.07}s`}>
          <span class="org-tag">{c.role}</span>
          <h3>{c.name}</h3>
          <p>{c.blurb}</p>
        </article>
      ))}
    </div>
  </section>

  <div class="ornament" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M12 3c-1.5 3-6 4.5-6 9a6 6 0 0 0 12 0c0-4.5-4.5-6-6-9Z" />
    </svg>
  </div>

  <!-- ===================== FIELD NOTES (ABOUT) ===================== -->
  <section class="wrap" id="about">
    <p class="eyebrow reveal">Field notes</p>
    <h2 class="section-title reveal">Off the clock.</h2>

    <div class="notes-grid">
      <div class="note reveal">
        <h3>The chai ritual</h3>
        <p>Crushed ginger, two cardamom pods, leaves from home. The kettle sings; the code can wait. <a href="https://masalaandchai.com/masala-chai/" target="_blank" rel="noopener">The recipe</a>, if you’d like to join.</p>
      </div>
      <div class="note reveal" style="--reveal-delay:.07s">
        <h3>Curious, chronically</h3>
        <p>India, technology, education, travel, yoga, and lately finance &amp; public policy. On a lifelong quest to collect languages. <a href="https://medium.com/pruthvi-shetty/the-bookmark-67aa0993155a" target="_blank" rel="noopener">The Bookmark</a> holds my favorite reads, podcasts, and playlists.</p>
      </div>
      <div class="note reveal" style="--reveal-delay:.14s">
        <h3>In motion</h3>
        <p>Racquetball, swimming, and long walks with my wife — where most of the good ideas actually show up.</p>
      </div>
      <div class="note reveal" style="--reveal-delay:.21s">
        <h3>Personality, allegedly</h3>
        <p><a href="https://www.16personalities.com/enfj-personality" target="_blank" rel="noopener">ENFJ-A</a> — shared, apparently, with Mandela, Obama, and Sheryl Sandberg. The bar is set.</p>
      </div>
      <div class="note reveal" style="--reveal-delay:.28s">
        <h3>Six-year-old philosophy</h3>
        <p>Most of what I know about wonder I learned from <a href="https://www.gocomics.com/calvinandhobbes" target="_blank" rel="noopener">a kid and his tiger</a>. “There’s treasure everywhere.”</p>
      </div>
      <div class="note reveal" style="--reveal-delay:.35s">
        <h3>Elsewhere</h3>
        <p>Essays on <a href="https://medium.com/@pruthvishetty" target="_blank" rel="noopener">Medium</a>, poems and scribbles on <a href="https://pruthvishetty.substack.com/" target="_blank" rel="noopener">Shetty’s Scrapbook</a>, quick takes on <a href="https://x.com/pruthvishetty" target="_blank" rel="noopener">X</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ cities }}>
  // Postcard deck: shuffle through the cities.
  function initPostcards() {
    const card = document.getElementById('postcard');
    if (!card || card.dataset.wired) return;
    card.dataset.wired = '1';

    let idx = Math.floor(Math.random() * cities.length);
    const img = document.getElementById('postcard-img');
    const name = document.getElementById('postcard-name');
    const note = document.getElementById('postcard-note');

    const show = (i) => {
      const c = cities[i];
      img.src = `/assets/images/${c.img}`;
      img.alt = c.name;
      name.textContent = c.name;
      note.textContent = c.note;
    };
    show(idx);

    // pre-warm the next image so the flip never flashes
    const preload = (i) => { new Image().src = `/assets/images/${cities[i % cities.length].img}`; };
    preload(idx + 1);

    card.addEventListener('click', () => {
      card.classList.remove('flip');
      void card.offsetWidth;
      card.classList.add('flip');
      idx = (idx + 1) % cities.length;
      setTimeout(() => show(idx), 180);
      preload(idx + 1);
    });
  }
  document.addEventListener('astro:page-load', initPostcards);
  initPostcards();
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-6);
    align-items: center;
    padding-block: clamp(3rem, 9vh, 6.5rem) var(--space-6);
  }
  .hero h1 {
    font-size: var(--text-hero);
    margin-top: var(--space-3);
  }
  .pron {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.4em;
    vertical-align: super;
    margin-left: 0.5em;
    opacity: 0.55;
    transition: opacity 0.2s, transform 0.25s var(--ease-spring);
  }
  .pron:hover { opacity: 1; transform: scale(1.15); }
  .hero-line {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 70, 'WONK' 1;
    font-size: var(--text-lg);
    color: var(--ink-soft);
    margin-top: var(--space-3);
  }
  .hero-sub {
    max-width: 46ch;
    margin-top: var(--space-3);
    color: var(--ink-soft);
    font-size: var(--text-md);
  }
  .hero-cta {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-5);
  }

  /* ---------- postcards ---------- */
  .postcards { text-align: center; }
  .postcard {
    position: relative;
    display: block;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    background: var(--paper-raise);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.7rem 0;
    rotate: 2.2deg;
    cursor: pointer;
    box-shadow: 0 18px 40px -18px rgb(var(--shadow) / 0.45),
      0 2px 6px rgb(var(--shadow) / 0.08);
    transition: rotate 0.4s var(--ease-spring), transform 0.4s var(--ease-spring),
      box-shadow 0.4s var(--ease-spring);
  }
  .postcard:hover {
    rotate: 0.5deg;
    transform: translateY(-4px);
    box-shadow: 0 26px 50px -20px rgb(var(--shadow) / 0.5),
      0 2px 6px rgb(var(--shadow) / 0.08);
  }
  .postcard.flip { animation: card-toss 0.42s var(--ease-spring); }
  @keyframes card-toss {
    0% { transform: translateY(0) rotate(0); }
    45% { transform: translateY(-14px) rotate(-2.5deg); opacity: 0.6; }
    100% { transform: translateY(0) rotate(0); opacity: 1; }
  }
  .tape {
    position: absolute;
    top: -12px;
    left: 50%;
    translate: -50% 0;
    width: 92px;
    height: 26px;
    background: color-mix(in srgb, var(--marigold) 32%, var(--paper-raise));
    opacity: 0.85;
    rotate: -2deg;
    border-left: 1px dashed rgb(var(--shadow) / 0.15);
    border-right: 1px dashed rgb(var(--shadow) / 0.15);
    z-index: 2;
  }
  .postcard img {
    width: 100%;
    aspect-ratio: 7 / 5;
    object-fit: cover;
    border-radius: 3px;
    filter: sepia(0.14) contrast(1.02) saturate(0.94);
  }
  .stub {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0.65rem 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .stub-note { color: var(--ink-faint); letter-spacing: 0.04em; text-transform: none; }
  .postcard-hint { display: block; margin-top: var(--space-3); opacity: 0.75; }

  /* ---------- intro ---------- */
  .intro { padding-block: var(--space-5) 0; }
  .intro .prose { font-size: var(--text-md); margin-inline: auto; }
  .dropcap::first-letter {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 3.4em;
    line-height: 0.8;
    float: left;
    padding-right: 0.12em;
    padding-top: 0.08em;
    color: var(--chai);
  }

  /* ---------- shared section bits ---------- */
  .section-title {
    font-size: var(--text-xl);
    margin-block: var(--space-2) var(--space-5);
  }
  .section-gap { margin-top: var(--space-7); }

  /* ---------- timeline ---------- */
  .timeline {
    list-style: none;
    padding: 0;
    position: relative;
  }
  .tl-item {
    display: grid;
    grid-template-columns: 9.5rem auto 1fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    position: relative;
  }
  .tl-when {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: right;
    padding-top: 0.3rem;
  }
  .tl-when .mono-label:first-child { color: var(--chai); }
  .tl-dot {
    position: relative;
    width: 11px;
    margin-top: 0.55rem;
  }
  .tl-dot::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 14px;
    bottom: calc(-1 * var(--space-4) - 14px);
    width: 1px;
    translate: -50% 0;
