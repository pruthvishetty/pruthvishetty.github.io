---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const poems = (await getCollection('poems')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

/* first two lines of verse, for the card preview */
const preview = (body: string) =>
  body
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l && !l.startsWith('#'))
    .slice(0, 2)
    .join(' / ');

const essays = [
  {
    title: 'Between Goodbyes and Hellos',
    url: 'https://pruthvishetty.substack.com/p/between-goodbyes-and-hellos',
    source: 'Substack', year: '2025',
    blurb: 'A meditation on transitions — the pause between endings and new beginnings.',
  },
  {
    title: 'My Decade in Review: 2011–2021',
    url: 'https://medium.com/pruthvi-shetty/my-decade-in-review-2011-2021-21380fc0061',
    source: 'Medium', year: '2022',
    blurb: 'Ten years across two countries — education, careers, ventures, and milestones.',
  },
  {
    title: 'The Bookmark',
    url: 'https://medium.com/pruthvi-shetty/the-bookmark-67aa0993155a',
    source: 'Medium', year: '2021',
    blurb: 'A living collection of my favorite blogs, podcasts, comics, books, shows, and playlists.',
  },
  {
    title: 'Bloomington 101',
    url: 'https://medium.com/pruthvi-shetty/bloomington-101-32f534e8c038',
    source: 'Medium', year: '2017',
    blurb: 'The unofficial survival guide for international grad students landing at Indiana University.',
  },
  {
    title: 'Smart Voting',
    url: 'https://medium.com/pruthvi-shetty/smart-voting-8a083073028e',
    source: 'Medium', year: '2017',
    blurb: 'Modernizing Indian elections with Aadhaar and the India Stack.',
  },
  {
    title: 'Revamping Technical Education in India',
    url: 'https://medium.com/@pruthvishetty/revamping-undergraduate-education-in-india-934c904242d1',
    source: 'Medium', year: '2017',
    blurb: 'On the quality and employability gap in Indian engineering education.',
  },
  {
    title: 'Planning for a Better India',
    url: 'https://medium.com/pruthvi-shetty/planning-for-a-better-india-19233d9eaf90',
    source: 'Medium', year: '2017',
    blurb: 'Systemic reforms — synchronized elections, standardized calendars, and other quiet fixes.',
  },
];

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Writing — Pruthvi Shetty"
  description="Poems over chai, and essays over time — verse, reflections, and long-form writing by Pruthvi Shetty."
>
  <section class="wrap writing-hero">
    <p class="eyebrow reveal">Writing</p>
    <h1 class="reveal" style="--reveal-delay:.08s">Poems over chai,<br /><em>essays over time.</em></h1>
    <p class="lede reveal" style="--reveal-delay:.16s">
      Verse brewed here; longer steepings on
      <a href="https://pruthvishetty.substack.com/" target="_blank" rel="noopener">Shetty’s Scrapbook</a> and
      <a href="https://medium.com/@pruthvishetty" target="_blank" rel="noopener">Medium</a>.
    </p>
  </section>

  <!-- ---------- poems ---------- -->
  <section class="wrap">
    <h2 class="shelf-title reveal">The poems</h2>
    <div class="poem-grid">
      {poems.map((p, i) => (
        <a href={`/poems/${p.id}/`} class="poem-card reveal" style={`--reveal-delay:${(i % 3) * 0.07}s`}>
          <span class="poem-date mono-label">{fmtDate(p.data.date)}</span>
          <h3>{p.data.title}</h3>
          {p.data.theme && <p class="poem-theme">{p.data.theme}</p>}
          <p class="poem-preview">“{preview(p.body ?? '')} …”</p>
          <span class="poem-read mono-label">read →</span>
        </a>
      ))}
    </div>
  </section>

  <div class="ornament" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 6 9 17l-5-5" transform="rotate(8 12 12)" opacity="0" />
      <path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10Z" />
    </svg>
  </div>

  <!-- ---------- essays ---------- -->
  <section class="wrap">
    <h2 class="shelf-title reveal">Essays, elsewhere</h2>
    <ul class="essay-list">
      {essays.map((e) => (
        <li class="essay-item reveal">
          <a href={e.url} target="_blank" rel="noopener" class="essay-link">
            <span class="essay-title">{e.title}</span>
            <span class="essay-dots" aria-hidden="true"></span>
            <span class="essay-meta mono-label">{e.source} · {e.year} ↗</span>
          </a>
          <p class="essay-blurb">{e.blurb}</p>
        </li>
      ))}
    </ul>

    <p class="writing-foot mono-label reveal">
      ✍️ <a href="/write/" title="For the keeper of the password">those who know the password may write here</a>
    </p>
  </section>
</BaseLayout>

<style>
  .writing-hero {
    padding-block: clamp(3rem, 8vh, 5.5rem) var(--space-6);
  }
  .writing-hero h1 {
    font-size: var(--text-hero);
    margin-top: var(--space-3);
  }
  .writing-hero h1 em {
    font-style: italic;
    font-variation-settings: 'SOFT' 70, 'WONK' 1;
    color: var(--chai);
  }
  .lede {
    margin-top: var(--space-3);
    color: var(--ink-soft);
    font-size: var(--text-md);
    max-width: 50ch;
  }

  .shelf-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }

  .poem-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-3);
  }
  .poem-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--paper-raise);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s var(--ease-spring),
      border-color 0.3s;
  }
  /* a chai ring stain on every poem card — left by the author */
  .poem-card::after {
    content: '';
    position: absolute;
    right: -22px;
    top: -22px;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    border: 7px solid var(--chai);
    opacity: 0.07;
    transition: opacity 0.35s;
  }
  .poem-card:hover {
    transform: translateY(-4px);
    border-color: var(--line);
    box-shadow: 0 16px 34px -18px rgb(var(--shadow) / 0.35);
  }
  .poem-card:hover::after { opacity: 0.16; }
  .poem-card h3 {
    font-size: var(--text-lg);
    font-style: italic;
    font-variation-settings: 'SOFT' 60, 'WONK' 1;
  }
  .poem-theme {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }
  .poem-preview {
    color: var(--ink-faint);
    font-size: var(--text-sm);
    font-style: italic;
    margin-top: auto;
  }
  .poem-read { color: var(--chai); letter-spacing: 0.12em; }

  .essay-list { list-style: none; padding: 0; max-width: 46rem; }
  .essay-item {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line-soft);
  }
  .essay-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }
  .essay-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 560;
    transition: color 0.2s;
  }
  .essay-link:hover .essay-title { color: var(--chai); }
  .essay-dots {
    border-bottom: 1.5px dotted var(--line);
    transform: translateY(-0.25em);
  }
  .essay-blurb {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }

  .writing-foot {
    margin-top: var(--space-6);
    text-align: center;
    opacity: 0.8;
  }
  .writing-foot a { color: var(--ink-faint); }
  .writing-foot a:hover { color: var(--chai); }

  @media (max-width: 560px) {
    .essay-link { grid-template-columns: 1fr; gap: 0.1rem; }
    .essay-dots { display: none; }
  }
</style>
