---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">Pruthvi <em>Shetty</em></p>
        <p class="footer-tag">
          Made with <a id="chai-link" href="https://masalaandchai.com/masala-chai/" target="_blank" rel="noopener" title="The chai recipe">☕</a>&nbsp;
          and <a id="heart-link" class="heart" href="https://www.gocomics.com/calvinandhobbes" target="_blank" rel="noopener" title="It's a magical world">❤️</a>&nbsp;
          in San Francisco
        </p>
        <div class="socials">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d={s.icon} /></svg>
            </a>
          ))}
        </div>
      </div>

      <div class="footer-clock">
        <div class="clock-row">
          <span id="clock-time" class="clock-time"></span>
          <button id="clock-cycle" class="zone-btn" title="Cycle timezone">
            <span id="clock-zone">SF</span>
          </button>
        </div>
        <span id="clock-date" class="mono-label"></span>
        <div class="year-progress" title="The year, steeping">
          <div class="year-track"><div id="year-bar" class="year-fill"></div></div>
          <span id="year-label" class="mono-label"></span>
        </div>
      </div>
    </div>

    <div class="footer-base">
      <span class="mono-label">© {year} Pruthvi Shetty · hand-built, no template</span>
      <span class="mono-label footer-hint" aria-hidden="true">psst — try typing “chai”</span>
    </div>
  </div>

  <!-- the wagon waits at the edge of the page for those who know the code -->
</footer>

<style>
  .site-footer {
    margin-top: var(--space-7);
    border-top: 1px solid var(--line-soft);
    background: var(--paper-deep);
    padding-block: var(--space-6) var(--space-4);
  }
  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-5);
    align-items: start;
  }
  .footer-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .footer-name em {
    font-style: italic;
    font-variation-settings: 'SOFT' 60, 'WONK' 1;
    color: var(--chai);
  }
  .footer-tag {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }
  .footer-tag a { text-decoration: none; }
  .heart { display: inline-block; transition: transform 0.3s var(--ease-spring); }
  .heart:hover { transform: scale(1.25) rotate(-6deg); }

  .socials {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    flex-wrap: wrap;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    color: var(--ink-faint);
    border: 1px solid var(--line-soft);
    transition: color 0.2s, border-color 0.2s, transform 0.25s var(--ease-spring);
  }
  .socials a:hover {
    color: var(--chai);
    border-color: var(--chai);
    transform: translateY(-2px);
  }

  .footer-clock { text-align: right; }
  .clock-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    justify-content: flex-end;
  }
  .clock-time {
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-variant-numeric: tabular-nums;
  }
  .zone-btn {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--chai);
    border-radius: 999px;
    padding: 0.1em 0.7em;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .zone-btn:hover { background: var(--chai); color: var(--paper); }

  .year-progress { margin-top: var(--space-3); min-width: 220px; }
  .year-track {
    height: 4px;
    border-radius: 999px;
    background: var(--line-soft);
    overflow: hidden;
  }
  .year-fill {
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--chai), var(--marigold));
    transition: width 1.2s var(--ease-spring);
  }
  .year-progress .mono-label { display: block; margin-top: var(--space-1); }

  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line-soft);
  }
  .footer-hint { opacity: 0; transition: opacity 0.6s; }
  .footer-base:hover .footer-hint { opacity: 0.7; }

  @media (max-width: 640px) {
    .footer-clock, .clock-row { text-align: left; justify-content: flex-start; }
  }
</style>
